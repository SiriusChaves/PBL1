            <Label text="GAME OVER" textFill="WHITE">
               <font>
                  <Font size="56.0" />
               </font>
               <styleClass>
                  <String fx:value="mb-title" />
                  <String fx:value="game-over-title" />
               </styleClass>
            </Label>
            <Separator prefWidth="200.0" styleClass="game-over-separator" />
            <Label styleClass="game-over-main-message" text="Sua sanidade chegou a 0." textFill="WHITE">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
            <Label styleClass="game-over-secondary-message" text="A influência do Mega Brain foi longe demais..." textFill="WHITE">
